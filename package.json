{
  "name": "smartmonitor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.{js,mjs}\" \"*.{js,json,yaml,html}\" .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.{js,mjs}\" \"*.{js,json,yaml,html}\" .prettierrc.json",
    "firebase:emulators": "firebase emulators:start --only auth,firestore --import=./emulator-data --export-on-exit=./emulator-data",
    "firebase:emulators:exec": "firebase emulators:exec --only auth,firestore",
    "firebase:deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "test:firestore": "node --test tests/firestore.rules.test.mjs"
  },
  "dependencies": {
    "@firebase/app": "0.16.2",
    "@firebase/auth": "1.13.6",
    "@firebase/messaging": "0.13.3",
    "@vaadin/router": "^2.0.1",
    "lit": "^3.3.3",
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^10.12.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0"
  }
}
